Total Revenue = SUM(fact_sales[revenue])
Total Cost = SUM(fact_sales[cost])
Total Profit = SUM(fact_sales[profit])
Profit Margin = DIVIDE([Total Profit], [Total Revenue])
Total Expenses = SUM(fact_expenses[amount])
Average Order Value = AVERAGE(fact_sales[revenue])
Sales Quantity = SUM(fact_sales[quantity])
Year-to-Date Revenue = TOTALYTD([Total Revenue], dim_date[full_date])
Previous Month Revenue = CALCULATE([Total Revenue], DATEADD(dim_date[full_date], -1, MONTH))
Month-over-Month Growth = DIVIDE([Total Revenue] - [Previous Month Revenue], [Previous Month Revenue])
Year-over-Year Growth = DIVIDE([Total Revenue] - CALCULATE([Total Revenue], DATEADD(dim_date[full_date], -1, YEAR)), CALCULATE([Total Revenue], DATEADD(dim_date[full_date], -1, YEAR)))
Top Customer Revenue = MAXX(TOPN(1, SUMMARIZE(dim_customer, dim_customer[customer_name], "Revenue", [Total Revenue]), [Revenue], DESC), [Revenue])
